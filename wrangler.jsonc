{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appq",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "6efad745-9c13-4b5f-8b14-ab302229d07f","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "4b09c19372694c41972413021fccf58c" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
